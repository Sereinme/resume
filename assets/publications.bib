@inproceedings{yang_fast_2024,
	address = {Singapore},
	title = {A fast {C}/{N0} estimation method based on the ratio of acquisition correlation value},
	isbn = {978-981-99-6932-6},
	url = {https://link.springer.com/chapter/10.1007/978-981-99-6932-6_47},
	doi = {10.1007/978-981-99-6932-6_47},
	abstract = {The carrier-to-noise ratio (\$\$C/\{N\}\_\{0\}\$\$C/N0) is widely recognized as a vital measurement in Global Navigation Satellite System (GNSS) as it serves as a common indicator of signal power. Its significance is apparent in numerous scenarios such as receiver tracking loop operation, spoofing detection, satellite signal quality monitoring, positioning and system state evaluation. Thus, research on estimating \$\$C/\{N\}\_\{0\}\$\$C/N0has gained importance in practical applications. Most existing \$\$C/\{N\}\_\{0\}\$\$C/N0estimation methods rely on the tracking process as a premise, leading to poor accuracy in specific scenarios where the signal is sporadic, intermittent or data is relatively short. Moreover, the signal tracking process limits the response speed and accuracy of existing methods, making them impractical for emergency scenarios requiring rapid estimation. To address these limitations and expand the applicability of \$\$C/\{N\}\_\{0\}\$\$C/N0estimation, this paper proposes a fast \$\$C/\{N\}\_\{0\}\$\$C/N0estimation method based on the acquisition correlation ratio (ACR). This approach estimates \$\$C/\{N\}\_\{0\}\$\$C/N0in the acquisition stage using only millisecond observation information. Simulation and experimental results indicate that the proposed method can significantly enhance the estimation accuracy of \$\$C/\{N\}\_\{0\}\$\$C/N0in short data scenarios compared to existing methods, achieving an estimation error of 0.52 dBHz with 50ms data.},
	language = {en},
	booktitle = {China {Satellite} {Navigation} {Conference} ({CSNC} 2024) {Proceedings}},
	publisher = {Springer Nature},
	author = {Ma, Yimin and Li, Hong and Zhou, Ziheng and Wu, Zhenyang and Li, Wenhao and Lu, Mingquan},
	editor = {Yang, Changfeng and Xie, Jun},
	year = {2024},
	keywords = {Done, Acquisition correlation value, Fast, Short data},
	pages = {567--577},
	file = {Full Text PDF:/Users/sereinme/Zotero/storage/TKLWF29Y/Ma 等 - 2024 - A Fast CN0 Estimation Method Based on the Ratio of Acquisition Correlation Value.pdf:application/pdf},
}

@inproceedings{li_fd-deflate_2024,
	address = {Baltimore, Maryland},
	title = {An {FD}-{DEFLATE} data compression scheme for {C}/{N0} estimation in {GNSS} interference monitoring},
	issn = {2331-5954},
	url = {https://www.ion.org/publications/abstract.cfm?articleID=19871},
	doi = {10.33012/2024.19871},
	abstract = {Global Navigation Satellite System (GNSS) provides global users with high-precision positioning, navigation, and timing (PNT) service. However, due to its low signal power and public data structure, GNSS is vulnerable to threats of interference. GNSS interference can severely impact individual users, critical infrastructures, and safe-of-life applications that rely on GNSS PNT service, and a few GNSS interference incidents have occurred worldwide in the past decade, confirming the necessity of addressing this issue. Therefore, GNSS interference monitoring is crucial for ensuring GNSS-based systems’ continued performance and resilience. Analysis and monitoring of GNSS carrier-to-noise ratio C/N0 is a common method for GNSS interference monitoring. Nevertheless, monitoring GNSS interference involves processing a large amount of data, which may exceed the computing ability of local hardware. Meanwhile, authorized signals can also be utilized for monitoring GNSS interference, yet local hardware may be not accessible to authorized signals, limiting its monitoring performance. Due to local hardware burden and scenarios of authorized signals, there is a need in practical applications to transmit digital intermediate frequency signals to remote locations for GNSS interference monitoring. Effective compression algorithms are required for data compression to reduce the transmission cost and bandwidth. Existing compression methods are analyzed for GNSS data compression performance, which is not suitable for GNSS data compression due to poor compression rate or serious C/N0 loss. Based on this, an FD(Frequency Division)-DEFLATE compression scheme is proposed to achieve efficient compression performance. The proposed compression scheme transforms GNSS signals from the time domain to the frequency domain using DCT, followed by frequency division to retain crucial signal components, and compression encoder using the DEFLATE algorithm. Furthermore, hardware implementation of the FD-DEFLATE compression scheme is presented on the FPGA platform, showcasing its compression and real-time signal processing functionality. Targeting compression rate, stability of C/N0 loss, and impact of different compression parameters as evaluation metrics, the proposed compression scheme is tested with both simulation and real-world GPS L1 C/A signals. The results confirm the scheme’s effectiveness, which achieves a compression rate of approximately 9.5 and a C/N0 loss of 4.5 dBHz with real-world data. The stable C/N0 loss across different original C/N0 values further validates the scheme’s reliability for accurate signal quality assessment. Adjusting compression parameters can also control the balance between compression rate and C/N0 loss. The proposed FD-DEFLATE compression scheme offers a promising solution for efficient GNSS data compression in remote transmission of GNSS interference monitoring scenarios.},
	language = {en},
	urldate = {2025-01-02},
	booktitle = {Proceedings of the 37th {International} {Technical} {Meeting} of the {Satellite} {Division} of the {Institute} of {Navigation} ({ION} {GNSS}+ 2024)},
	author = {Li, Wenhao and Wang, Lingtao and Zhong, Minghan and Lu, Mingquan and Li, Hong},
	month = oct,
	year = {2024},
	keywords = {Done},
	pages = {818--829},
	file = {PDF:/Users/sereinme/Zotero/storage/XRCN8PZX/Li 等 - 2024 - An FD-DEFLATE Data Compression Scheme for CN0 Estimation in GNSS Interference Monitoring.pdf:application/pdf},
}

@article{zhong_feedback_2025,
	title = {Feedback node aided distributed spoofing system for global navigation satellite system time synchronisation attack},
	volume = {19},
	copyright = {© 2025 The Author(s). IET Radar, Sonar \& Navigation published by John Wiley \& Sons Ltd on behalf of The Institution of Engineering and Technology.},
	issn = {1751-8792},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1049/rsn2.70088},
	doi = {10.1049/rsn2.70088},
	abstract = {Global navigation satellite system (GNSS) is widely recognised to be vulnerable to spoofing attacks. A sophisticated form of GNSS spoofing, termed distributed spoofing, transmits each spoofing signal through dedicated antennas. This technique poses significant implementation difficulty in practical scenarios, owing to challenges including diverse propagation paths, inter-node clock synchronisation and transmit-receive isolation. This article proposes a feedback node aided distributed spoofing (FNA-DS) system for executing GNSS time synchronisation attacks, enabling flexible implementation of distributed spoofing. Leveraging observations from a feedback node, the time biases and drifts of each spoofing node are estimated in real time and compensated during spoofing signal generation, ensuring false position, velocity and timing (PVT) solution accuracy and high pseudorange consistency. By dedicating the feedback node exclusively to signal reception and the spoofing nodes solely to signal transmission, the requirement for transmit-receive isolation is relaxed. To comprehensively characterise the distributed spoofing threat, a detailed performance analysis of the FNA-DS system is conducted, quantifying the impact of node position errors and time parameter estimation errors. Field experiments using a self-developed distributed spoofing prototype validate the FNA-DS system's effectiveness and expose limitations in existing direction of arrival (DoA) based anti-spoofing techniques. Collectively, this work expands the capability frontier of GNSS spoofing, advances understanding of distributed spoofing and underscores its significance as a practical GNSS security threat.},
	language = {en},
	number = {1},
	urldate = {2025-11-19},
	journal = {IET Radar Sonar Navig.},
	author = {Zhong, Minghan and Li, Wenhao and Lu, Mingquan and Li, Hong},
	year = {2025},
	note = {\_eprint: https://ietresearch.onlinelibrary.wiley.com/doi/pdf/10.1049/rsn2.70088},
	keywords = {global navigation satellite system (GNSS), synchronisation, distributed spoofing, direction of arrival (DoA), receiver autonomous integrity monitoring (RAIM), transmit-receive isolation},
	pages = {e70088},
	file = {Full Text PDF:/Users/sereinme/Zotero/storage/6W8IH2JD/Zhong 等 - 2025 - Feedback node aided distributed spoofing system for global navigation satellite system time synchron.pdf:application/pdf;Snapshot:/Users/sereinme/Zotero/storage/VTHYELMB/rsn2.html:text/html},
}

@article{li_full-channel_2026,
	title = {Full-channel asynchronous spoofing technique for {GNSS} time synchronization attack},
	volume = {17},
	issn = {1949-3061},
	url = {https://ieeexplore.ieee.org/document/11206492/metrics},
	doi = {10.1109/TSG.2025.3622566},
	abstract = {Global Navigation Satellite System (GNSS) based time synchronization serves as the cornerstone of modern power systems. Defense against Time Synchronization Attacks (TSAs) is crucial for cybersecurity and the protection of smart grids. Establishing feasible conditions for TSA forms the foundation for developing corresponding defense technologies. This requires exploring potential TSA implementations. Currently, the full-channel synchronous spoofing method represents the only practically implemented and well-validated TSA approach. This method deceives timing results without altering position or velocity by simultaneously applying identical pseudorange spoofing modifications across all channels. However, this synchronous pseudorange operation introduces channel-wise synchronicity, which has been demonstrated as a detectable feature by existing research. Analysis reveals that achieving TSA does not necessitate synchronous pseudorange manipulation across channels when the spoofing-induced deviations are maintained below the inherent GNSS errors. Based on this, we propose a potential TSA approach named the full-channel asynchronous spoofing method. This proposed method asynchronously manipulates pseudorange spoofing modifications across individual channels, achieving TSA while eliminating channel-wise synchronicity. Due to asynchronous channel operations, experimental results confirm the feasibility of the proposed method and demonstrate its enhanced concealment against existing anti-TSA detection methods designed for full-channel synchronous spoofing. This research extends TSA defense targets from full-channel synchronous to full-channel asynchronous spoofing scenarios, thereby resulting in performance degradation or even detection failure of current anti-TSA methods. Furthermore, the proposed method redefines the boundary for TSAs and raises time security concerns in smart grids. It can also serve as a novel testing entity for timing security, advancing the development of grid timing protection mechanisms.},
	language = {en},
	number = {2},
	urldate = {2026-02-22},
	journal = {IEEE Trans. Smart Grid},
	author = {Li, Wenhao and Zhong, Minghan and Lu, Mingquan and Li, Hong},
	month = mar,
	year = {2026},
	keywords = {Global navigation satellite system, Receivers, Satellites, Smart grids, Synchronization, time synchronization attack, Phasor measurement units, global navigation satellite system, Clocks, Power system stability, phasor measurement units, Cybersecurity, time security, Accuracy, Protection},
	pages = {1492--1502},
	file = {PDF:/Users/sereinme/Zotero/storage/7W8FHCCX/Li 等 - 2026 - Full-channel asynchronous spoofing technique for GNSS time synchronization attack.pdf:application/pdf},
}
